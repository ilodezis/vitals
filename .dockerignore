# Python envs / caches — never bake the host venv (Windows binaries) into a Linux image
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (node_modules is build-only)
node_modules/
web/node_modules/
frontend/node_modules/
# The React app is built inside the image; a local build must not leak in
web/static/app/

# Secrets + local artifacts (env is injected at runtime via compose env_file)
.env
.env.local
*.db
backups/
# User uploads (photos, lab documents) are bind-mounted at runtime; baking a
# copy into every image layer is both dead weight and a privacy leak
web/static/uploads/
# README media, not needed at runtime
gifs/
.coverage
htmlcov/

# Repo / scratch
.git/
.gitignore
test_*.txt
_boot_check.py
