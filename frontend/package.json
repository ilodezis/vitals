{
  "name": "vitals-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b && vitest run && vite build && node scripts/check-size.mjs",
    "gen": "npm run gen:openapi && npm run gen:api && npm run gen:i18n",
    "gen:openapi": "cd .. && python scripts/dump_openapi.py",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:i18n": "cd .. && python scripts/export_i18n.py"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/golos-text": "5.3.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-query-persist-client": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "idb-keyval": "6.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@tanstack/router-plugin": "1.168.48",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.3"
    },
    "minimatch": "^11.0.3"
  }
}
