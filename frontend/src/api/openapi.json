  "info": {
    "title": "Vitals API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/session": {
      "get": {
        "description": "Who is signed in, the UI language, and everything the shell draws from: the\nmodule switches, the navigation built from them, the rail's status card.",
        "operationId": "read_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
